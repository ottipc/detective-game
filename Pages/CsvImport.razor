@page "/csv-import"
@using System.Globalization
@using CsvHelper
@using CsvHelper.Configuration
@using Microsoft.AspNetCore.Components.Forms
@using ApexCharts

<PageTitle>CSV Import - Crime Analytics</PageTitle>

<h3>🔍 CSV Daten Import & Crime Analytics Dashboard</h3>

<div class="upload-section">
    <InputFile OnChange="@HandleFileSelected" accept=".csv" class="file-input" />
    @if (_isLoading)
    {
        <div class="spinner"></div>
        <span>Datei wird verarbeitet...</span>
    }
    @if (_errorMessage != null)
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
</div>

@if (_records.Any())
{
    <div class="dashboard-container">
        <div class="charts-grid">
            <div class="chart-card">
                <h4>📊 Gelöste Fälle - Top Detektive</h4>
                @if (_suspicionData.Any())
                {
                    <ApexChart TItem="ChartData" Title="">
                        <ApexPointSeries TItem="ChartData"
                                        Items="_suspicionData"
                                        Name="Gelöste Fälle"
                                        SeriesType="SeriesType.Bar"
                                        XValue="@(e => e.Label)"
                                        YAggregate="@(e => e.Sum(y => y.Value))"
                                        OrderByDescending="e => e.Y" />
                    </ApexChart>
                }
            </div>
            
            <div class="chart-card">
                <h4>🎂 Altersverteilung</h4>
                @if (_ageData.Any())
                {
                    <ApexChart TItem="ChartData" Title="">
                        <ApexPointSeries TItem="ChartData"
                                        Items="_ageData"
                                        Name="Detektive"
                                        SeriesType="SeriesType.Pie"
                                        XValue="@(e => e.Label)"
                                        YAggregate="@(e => e.Sum(y => y.Value))" />
                    </ApexChart>
                }
            </div>
            
            <div class="chart-card">
                <h4>🗺️ Top Städte</h4>
                @if (_locationData.Any())
                {
                    <ApexChart TItem="ChartData" Title="">
                        <ApexPointSeries TItem="ChartData"
                                        Items="_locationData"
                                        Name="Anzahl Verdächtige"
                                        SeriesType="SeriesType.Bar"
                                        XValue="@(e => e.Label)"
                                        YAggregate="@(e => e.Sum(y => y.Value))"
                                        OrderByDescending="e => e.Y" />
                    </ApexChart>
                }
            </div>
            
            <div class="chart-card stats-card">
                <h4>📈 Statistiken</h4>
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-value">@_records.Count</div>
                        <div class="stat-label">Verdächtige</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@GetAverageAge()</div>
                        <div class="stat-label">Ø Alter</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@GetTopLocation()</div>
                        <div class="stat-label">Häufigster Ort</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="data-section">
        <div class="controls-bar">
            <div class="info">
                <strong>@_records.Count</strong> Datensätze geladen
            </div>
            <div class="filter-box">
                <input type="text" 
                       @bind="_filterText" 
                       @bind:event="oninput"
                       placeholder="🔍 Suche in allen Spalten..." 
                       class="search-input" />
            </div>
        </div>

        <div class="table-container">
            <table class="data-grid">
                <thead>
                    <tr>
                        @foreach (var header in _headers)
                        {
                            <th @onclick="() => SortBy(header)" class="sortable">
                                @header
                                @if (_sortColumn == header)
                                {
                                    <span class="sort-indicator">@(_sortAscending ? "▲" : "▼")</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in GetFilteredAndSortedRecords())
                    {
                        <tr>
                            @foreach (var header in _headers)
                            {
                                <td>@record.GetValueOrDefault(header, "")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (GetFilteredAndSortedRecords().Count() == 0 && _records.Any())
        {
            <div class="no-results">
                Keine Ergebnisse für "<strong>@_filterText</strong>" gefunden
            </div>
        }
    </div>
}
else if (!_isLoading)
{
    <div class="empty-state">
        <div class="empty-icon">📄</div>
        <h4>Keine Daten geladen</h4>
        <p>Wählen Sie eine CSV-Datei aus, um zu beginnen</p>
    </div>
}

@code {
    private List<Dictionary<string, string>> _records = new();
    private List<string> _headers = new();
    private string? _errorMessage;
    private bool _isLoading;
    private string _filterText = "";
    private string? _sortColumn;
    private bool _sortAscending = true;

    private List<ChartData> _suspicionData = new();
    private List<ChartData> _ageData = new();
    private List<ChartData> _locationData = new();

    public class ChartData
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _isLoading = true;
        _errorMessage = null;
        _records.Clear();
        _headers.Clear();
        StateHasChanged();

        try
        {
            var file = e.File;
            
            if (file.Size > 10 * 1024 * 1024)
            {
                _errorMessage = "Datei ist zu groß (max. 10 MB)";
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            using var csv = new CsvReader(reader, new CsvConfiguration(CultureInfo.InvariantCulture)
            {
                Delimiter = ";",
                HasHeaderRecord = true,
                MissingFieldFound = null,
                BadDataFound = null
            });

            await csv.ReadAsync();
            csv.ReadHeader();
            _headers = csv.HeaderRecord?.ToList() ?? new List<string>();

            while (await csv.ReadAsync())
            {
                var record = new Dictionary<string, string>();
                foreach (var header in _headers)
                {
                    record[header] = csv.GetField(header) ?? "";
                }
                _records.Add(record);
            }

            GenerateCharts();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fehler beim Laden der Datei: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void GenerateCharts()
    {
        // Suspicion Chart
        if (_headers.Contains("Faelle_Geloest"))
        {
            _suspicionData = _records
                .Where(r => int.TryParse(r.GetValueOrDefault("Faelle_Geloest", "0"), out _))
                .OrderByDescending(r => int.Parse(r.GetValueOrDefault("Faelle_Geloest", "0")))
                .Take(10)
                .Select(r => new ChartData
                {
                    Label = r.GetValueOrDefault("Name", "Unknown"),
                    Value = int.Parse(r.GetValueOrDefault("Faelle_Geloest", "0"))
                })
                .ToList();
        }

        // Age Distribution
        if (_headers.Contains("Alter"))
        {
            _ageData = _records
                .Where(r => int.TryParse(r.GetValueOrDefault("Alter", "0"), out _))
                .Select(r => int.Parse(r.GetValueOrDefault("Alter", "0")))
                .GroupBy(age => (age / 10) * 10)
                .OrderBy(g => g.Key)
                .Select(g => new ChartData
                {
                    Label = $"{g.Key}-{g.Key + 9}",
                    Value = g.Count()
                })
                .ToList();
        }

        // Location Distribution
        if (_headers.Contains("Stadt"))
        {
            _locationData = _records
                .GroupBy(r => r.GetValueOrDefault("Stadt", "Unknown"))
                .OrderByDescending(g => g.Count())
                .Take(5)
                .Select(g => new ChartData
                {
                    Label = g.Key,
                    Value = g.Count()
                })
                .ToList();
        }
    }

    private string GetAverageAge()
    {
        if (!_headers.Contains("Alter")) return "N/A";
        
        var ages = _records
            .Where(r => int.TryParse(r.GetValueOrDefault("Alter", "0"), out _))
            .Select(r => int.Parse(r.GetValueOrDefault("Alter", "0")))
            .ToList();
        
        return ages.Any() ? Math.Round(ages.Average(), 1).ToString() : "N/A";
    }

    private string GetTopLocation()
    {
        if (!_headers.Contains("Stadt")) return "N/A";
        
        return _records
            .GroupBy(r => r.GetValueOrDefault("Stadt", "Unknown"))
            .OrderByDescending(g => g.Count())
            .FirstOrDefault()?.Key ?? "N/A";
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private IEnumerable<Dictionary<string, string>> GetFilteredAndSortedRecords()
    {
        var filtered = _records.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_filterText))
        {
            filtered = filtered.Where(record =>
                record.Values.Any(value =>
                    value.Contains(_filterText, StringComparison.OrdinalIgnoreCase)));
        }

        if (_sortColumn != null)
        {
            filtered = _sortAscending
                ? filtered.OrderBy(r => r.GetValueOrDefault(_sortColumn, ""))
                : filtered.OrderByDescending(r => r.GetValueOrDefault(_sortColumn, ""));
        }

        return filtered;
    }
}
