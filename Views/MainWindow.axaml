<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Detektivspiel.Views.MainWindow"
        Title="Detektivspiel" Width="600" Height="420">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="🕵️‍♂️ Der Mord im Herrenhaus" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

    <Button x:Name="StartButton" Content="Spiel starten" Width="150" Height="40"/>

    <ComboBox x:Name="SuspectBox" Width="250" Height="35" IsEnabled="False" />
    <Button x:Name="GuessButton" Content="Rate den Täter" Width="150" Height="40" IsEnabled="False" />

    <TextBlock x:Name="ResultText" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>

    <ListBox x:Name="OutputBox" Height="180"/>
  </StackPanel>
</Window>
